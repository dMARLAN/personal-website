# Copy to src/api/.env for `make run` and `make backup` (outside Tilt); paths are relative to src/api. Never commit
# .env: it holds secrets.

# Where the SQLite database (site.db) and the uploaded resume PDF (resume.pdf) live. Created if missing.
STORAGE_DATA_DIR=./.data

# An argon2 hash of the admin password: `make hash-password`. Unset disables admin login.
# Single-quote it: the hash contains `$`.
ADMIN_AUTH_PASSWORD_HASH=''

# The Next.js on-demand revalidation route, and the secret it expects as `Authorization: Bearer <secret>`.
REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=change-me

# Browser origins allowed to call the API with credentials (JSON list).
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
