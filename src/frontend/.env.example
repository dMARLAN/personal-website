# API base URL, inlined at build time. Leave it unset to let the browser
# derive it from the current hostname (http://<current-hostname>:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL for server-side fetches; wins over NEXT_PUBLIC_API_URL there.
API_INTERNAL_URL=

# Comma-separated hosts Next's dev server accepts cross-origin /_next/*
# requests from (Tilt fills this in from the tailnet identity).
ALLOWED_DEV_ORIGINS=
