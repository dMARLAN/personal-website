# Copy to src/frontend/.env.local for `npm run dev` / `npm run start` outside Tilt.

# Where the Next.js server reaches FastAPI: content fetches, and the /api/* rewrite that gives the browser the API at
# the site's own origin. `next build` bakes the rewrite in. Unset means http://localhost:8000 (the API's `make run`).
API_INTERNAL_URL=http://localhost:8000

# The bearer secret the API sends to POST /revalidate. Must equal the API's REVALIDATE_SECRET (src/api/.env).
REVALIDATE_SECRET=change-me

# Comma-separated hosts Next's dev server accepts cross-origin /_next/*
# requests from (Tilt fills this in from the tailnet identity).
ALLOWED_DEV_ORIGINS=
